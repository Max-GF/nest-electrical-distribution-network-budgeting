@baseURL = http://localhost:3333 
@authToken = {{authentificate.response.body.accessToken}}

###
# @name authentificate
POST {{baseURL}}/authenticate
Content-Type: application/json

{
  "email": "max@test.com",
  "password": "123456"
}
###

# @name create_company
POST {{baseURL}}/companies
Content-Type: application/json
Authorization: Bearer {{authToken}}
 
{
    "name": "Test Company",
    "cnpj": "41735673000177"
}
###

# @name fetch_companies
GET {{baseURL}}/companies?page=1&pageSize=10
Content-Type: application/json
Authorization: Bearer {{authToken}}
 

###

# @name create_base
POST {{baseURL}}/bases
Content-Type: application/json
Authorization: Bearer {{authToken}}
 
{
    "name": "Test Base",
    "companyId": "a5d128ab-f14d-4fd5-ac36-394a0316f400"
}
###

# @name fetch_bases
GET {{baseURL}}/bases/351d141d-2465-4ba3-a766-c86ae84c8a2b
Content-Type: application/json
Authorization: Bearer {{authToken}}
 

###

# @name create_account
POST {{baseURL}}/accounts
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
    "cpf" : "415.572.120-15",
    "name": "Max",
    "email": "max@test.com",
    "password": "123456",
    "role" : "ADMIN",
    "companyId": "a5d128ab-f14d-4fd5-ac36-394a0316f400",
    "baseId" : "e45c9eb4-f9a6-4de1-adbb-11d3ee053821"
}
###

# @name fetch_accounts
GET {{baseURL}}/accounts?ids=9d980633-057e-4674-9e55-eb7b103e6edb
Content-Type: application/json
Authorization: Bearer {{authToken}}


